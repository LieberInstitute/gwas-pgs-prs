## example project config for BPD GWAS and MBv genotypes

BCFTOOLS=/opt/sw/bin/bcftools
PLINK2=plink2
PRSICE=/opt/sw/bin/PRSice_linux
THREADS=8

PROJECT_DIR=/dbdata/cdb/gwas-pgs-prs
WORK_DIR=/dbdata/cdb/gwas-pgs-prs/work/mbv_bpd
TMPDIR_ROOT=/dbdata/cdb/gwas-pgs-prs/work/mbv_bpd/tmp

## GWAS conversion references used by bcftools +munge/+liftover
GWAS_SOURCE_FASTA=/dbdata/cdb/ref/GRCh37/human_g1k_v37.fasta
GWAS_TARGET_FASTA=/dbdata/cdb/ref/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fna
GWAS_LIFTOVER_CHAIN=/dbdata/cdb/ref/hg19ToHg38.over.chain.gz

## target genotype QC reference
REF_FASTA=/dbdata/cdb/genotyping/ref/hg38c.fa
TARGET_VCF=/dbdata/cdb/gwas-pgs-prs/mbv-prs/genotypes/merged_R.8_MAF.01.RSann.vcf.gz
TARGET_PREFIX=mbv
DEMOGRAPHICS=/dbdata/cdb/gwas-pgs-prs/mbv-prs/MBv_demographics_n119.tab
PHENO_ID_COL=BrNum
PHENO_GROUP_COL=PrimaryDx
HWE_CONTROL_VALUE=Control

PRSICE_THRESHOLDS=5e-8,1e-6,1e-4,0.001,0.01,0.05,0.1,0.5,1
PRSICE_CLUMP_KB=250
PRSICE_CLUMP_R2=0.1
PRSICE_CLUMP_P=1

GWAS_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/gwas_manifest.tsv
PGS_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/pgs_manifest.tsv
SCORE_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/score_manifest.tsv
PRSICE_BASE_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/prsice_base_manifest.tsv
PRSICE_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/prsice_manifest.tsv
PRSICE_MODEL_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/prsice_model_manifest.tsv
SCORE_LONG_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/score_long_manifest.tsv
SUMMARY_OUT_DIR=/dbdata/cdb/gwas-pgs-prs/work/mbv_bpd/summary
COMPARE_MANIFEST=/dbdata/cdb/gwas-pgs-prs/examples/mbv_bpd/score_long_manifest.tsv
COMPARE_OUT_DIR=/dbdata/cdb/gwas-pgs-prs/work/mbv_bpd/comparison
